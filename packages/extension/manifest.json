{
  "manifest_version": 3,
  "name": "Latch",
  "version": "0.1.0",
  "description": "Browser hands for agents. Attaches to the Chrome you already use.",
  "icons": {
    "16": "icon/16.png",
    "32": "icon/32.png",
    "48": "icon/48.png",
    "128": "icon/128.png"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "debugger",
    "storage",
    "alarms",
    "windows"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Latch"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
